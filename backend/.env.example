# 复制本文件为 backend/.env 后填写。不要把 .env 提交到 Git，也不要把密钥贴到聊天里。
# 改完后必须重启后端。下面这三项都填好，网站上的「去支付」才会打开 Stripe。

# Stripe 测试模式密钥，以 sk_test_ 开头。Dashboard → 开发者 → API 密钥。
STRIPE_SECRET_KEY=

# 本地测试用 Stripe CLI 打印的 whsec_。运行：
# stripe listen --forward-to localhost:8000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=

# 测试模式里「每月 ¥19.00 CNY」这个价格的 Price ID，以 price_ 开头。
STRIPE_PRICE_ID=

# 支付完成后跳回的网站地址，不要以斜杠结尾。
PUBLIC_APP_URL=http://localhost:3000

# 可选。登录状态加密用，不填会在 backend/data/session_secret 自动生成。
SESSION_SECRET=

# 可选。只有浏览器或后端打不开 api.stripe.com / checkout.stripe.com 时才填。
# 示例：STRIPE_PROXY=http://127.0.0.1:7890
STRIPE_PROXY=
